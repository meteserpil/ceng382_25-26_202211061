@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-6">
            <h2>@(Model.EditId.HasValue ? "Edit Class" : "Add New Class")</h2>
            <form method="post">
                <input type="hidden" asp-for="EditId" />
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label">Class Name *</label>
                    <input asp-for="NewClass.ClassName" class="form-control" required />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label">Student Count *</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" required min="1" max="1000" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.Description" class="form-label">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    @if (Model.EditId.HasValue)
                    {
                        <button type="submit" asp-page-handler="Update" class="btn btn-success">Update</button>
                        <button type="submit" asp-page-handler="Cancel" class="btn btn-secondary">Cancel</button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                    }
                </div>
            </form>
        </div>
        
        <!-- Table Column -->
        <div class="col-md-6">
            <h2>Class List</h2>
            @if (Model.AllClasses.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Class Name</th>
                            <th>Students</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in Model.AllClasses)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <button type="submit" asp-page-handler="Edit" asp-route-id="@classInfo.Id" 
                                                class="btn btn-sm btn-warning">Edit</button>
                                    </form>
                                    <form method="post" class="d-inline">
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@classInfo.Id" 
                                                class="btn btn-sm btn-danger" 
                                                onclick="return confirm('Are you sure?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No classes added yet.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
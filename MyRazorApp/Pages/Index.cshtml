@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-6">
            <h2>@(Model.EditId.HasValue ? "Edit Class" : "Add New Class")</h2>
            <form method="post">
                <input type="hidden" asp-for="EditId" />
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label">Class Name *</label>
                    <input asp-for="NewClass.ClassName" class="form-control" required />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label">Student Count *</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" required min="1" max="1000" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="NewClass.Description" class="form-label">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    @if (Model.EditId.HasValue)
                    {
                        <button type="submit" asp-page-handler="Update" class="btn btn-success">Update</button>
                        <button type="submit" asp-page-handler="Cancel" class="btn btn-secondary">Cancel</button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                    }
                </div>
            </form>
        </div>
        
        <!-- Table Column -->
        <div class="col-md-6">
            <h2>Class List</h2>
            
            <form method="get" class="mb-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="FilterClassName" class="form-label">Class Name</label>
                        <input asp-for="FilterClassName" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FilterMinStudents" class="form-label">Min Students</label>
                        <input asp-for="FilterMinStudents" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FilterMaxStudents" class="form-label">Max Students</label>
                        <input asp-for="FilterMaxStudents" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>
                </div>
            </form>

            @if (Model.Classes.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Class Name</th>
                            <th>Students</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in Model.Classes)
                        {
                            <tr data-class-id="@classInfo.Id" 
                                class="@(TempData["HighlightClassId"]?.ToString() == classInfo.Id.ToString() ? "table-success" : "")">
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <button type="submit" asp-page-handler="Edit" asp-route-id="@classInfo.Id" 
                                                class="btn btn-sm btn-warning">Edit</button>
                                    </form>
                                    <form method="post" class="d-inline">
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@classInfo.Id" 
                                                class="btn btn-sm btn-danger" 
                                                onclick="return confirm('Are you sure?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Page("Index", new { 
                                    CurrentPage = Model.CurrentPage - 1, 
                                    FilterClassName = Model.FilterClassName,
                                    FilterMinStudents = Model.FilterMinStudents,
                                    FilterMaxStudents = Model.FilterMaxStudents
                                })">Previous</a>
                            </li>
                        }
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Page("Index", new { 
                                    CurrentPage = i, 
                                    FilterClassName = Model.FilterClassName,
                                    FilterMinStudents = Model.FilterMinStudents,
                                    FilterMaxStudents = Model.FilterMaxStudents
                                })">@i</a>
                            </li>
                        }
                        
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Page("Index", new { 
                                    CurrentPage = Model.CurrentPage + 1, 
                                    FilterClassName = Model.FilterClassName,
                                    FilterMinStudents = Model.FilterMinStudents,
                                    FilterMaxStudents = Model.FilterMaxStudents
                                })">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
                
                <div class="text-muted">
                    Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to 
                    @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of 
                    @Model.TotalItems classes
                </div>

                <!-- Enhanced JSON Export Section -->
                <div class="mt-3 border-top pt-3">
                    <h4>Export to JSON</h4>
                    <form method="get" asp-page-handler="ExportJson" class="mb-3">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="exportFiltered" id="exportAll" value="false" checked>
                                    <label class="form-check-label" for="exportAll">
                                        Export All Data
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="exportFiltered" id="exportFiltered" value="true">
                                    <label class="form-check-label" for="exportFiltered">
                                        Export Filtered Data
                                    </label>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-2">Select Columns (enter numbers separated by commas):</div>
                                <input type="text" id="columnNumbers" class="form-control" placeholder="Example: 1,3,4">
                                <small class="text-muted">1: ID, 2: Class Name, 3: Student Count, 4: Description</small>
                                
                                <input type="hidden" name="selectedColumns" id="selectedColumns">
                                
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge bg-secondary" id="badge-1" data-value="Id">1: ID</span>
                                    <span class="badge bg-secondary" id="badge-2" data-value="ClassName">2: Class Name</span>
                                    <span class="badge bg-secondary" id="badge-3" data-value="StudentCount">3: Student Count</span>
                                    <span class="badge bg-secondary" id="badge-4" data-value="Description">4: Description</span>
                                </div>
                            </div>
                            
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-success">Export JSON</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="alert alert-info">No classes found matching your criteria.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const columnMap = {
                '1': { id: 'badge-1', value: 'Id' },
                '2': { id: 'badge-2', value: 'ClassName' },
                '3': { id: 'badge-3', value: 'StudentCount' },
                '4': { id: 'badge-4', value: 'Description' }
            };

            const columnNumbers = document.getElementById('columnNumbers');
            const selectedColumns = document.getElementById('selectedColumns');
            
            // Initialize - no columns selected by default
            updateColumnSelection([]);
            
            // Update selection when input changes
            columnNumbers.addEventListener('input', function() {
                const numbers = this.value.split(',').map(num => num.trim());
                const selectedValues = [];
                
                numbers.forEach(num => {
                    if (columnMap[num]) {
                        selectedValues.push(columnMap[num].value);
                    }
                });
                
                selectedColumns.value = selectedValues.join(',');
                updateColumnSelection(numbers);
            });

            function updateColumnSelection(selectedNumbers) {
                // Reset all badges to default
                Object.values(columnMap).forEach(col => {
                    const badge = document.getElementById(col.id);
                    badge.classList.remove('bg-success');
                    badge.classList.add('bg-secondary');
                });
                
                // Highlight selected badges
                selectedNumbers.forEach(num => {
                    if (columnMap[num]) {
                        const badge = document.getElementById(columnMap[num].id);
                        badge.classList.remove('bg-secondary');
                        badge.classList.add('bg-success');
                    }
                });
            }

            // Highlight newly added/edited rows
            const highlightClass = '@(TempData["HighlightClassId"]?.ToString())';
            if (highlightClass) {
                const row = document.querySelector(`tr[data-class-id="${highlightClass}"]`);
                if (row) {
                    row.classList.add('table-success');
                    setTimeout(() => {
                        row.classList.remove('table-success');
                    }, 3000);
                }
            }
        });
    </script>
}